<AnchorPane prefHeight="646.0" prefWidth="937.0" style="-fx-background-color: #E5E5E5;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.UserLoginFormController">
